# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and configure your environment variables.
# ==============================================================================

# MongoDB Connection String (Atlas URI)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.pwkfalj.mongodb.net/<database_name>?retryWrites=true&w=majority"

# Server Port
PORT=3000

# Application Environment
NODE_ENV="development"

# GEMINI_API_KEY: Optional for Gemini AI features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL
APP_URL="http://localhost:3000"
